      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بازخورد"
          }
        }
      }
    },
    "Feedback Key" : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلید بازخورد"
          }
        }
      }
    },
    "Feedback is sealed to this key. Its public key goes in WhippetFeedbackPublicKey in project.yml. The private key syncs through iCloud Keychain; back it up too, since feedback sealed to a lost key can't be read." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بازخورد با این کلید رمزگذاری می‌شود. کلید عمومی آن در WhippetFeedbackPublicKey در project.yml قرار می‌گیرد. کلید خصوصی از طریق جاکلیدی iCloud همگام‌سازی می‌شود؛ از آن نسخهٔ پشتیبان هم تهیه کنید، چون بازخوردی که با کلید گم‌شده رمزگذاری شده خواندنی نیست."
          }
        }
      }
    },
    "Feedback sealed to the current key can't be read without it." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بازخوردی که با کلید فعلی رمزگذاری شده بدون آن خواندنی نیست."
          }
        }
      }
    },
