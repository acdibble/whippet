    },
    "The extension has no name." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افزونه نامی ندارد."
          }
        }
      }
    },
    "The extension needs API version %lld, and this Whippet supports version 1." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
